{
  "title": "RunbookQA",
  "uid": "67021a0d-6634-418e-b1ad-c5959341ef34",
  "tags": ["runbookqa"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Total /ask requests",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(runbookqa_ask_total)", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Refusal rate",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [{"expr": "sum(runbookqa_refusals_total) / sum(runbookqa_ask_total)", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Retrieval hit rate",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [{"expr": "sum(runbookqa_retrieval_latency_seconds_count{result=\"hit\"}) / sum(runbookqa_retrieval_latency_seconds_count)", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "/ask latency (p50 / p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(runbookqa_ask_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum(rate(runbookqa_ask_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "B"}
      ]
    },
    {
      "id": 5,
      "title": "Retrieval vs generation latency (p50)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(runbookqa_retrieval_latency_seconds_bucket[5m])) by (le))", "legendFormat": "retrieval p50", "refId": "A"},
        {"expr": "histogram_quantile(0.5, sum(rate(runbookqa_generation_latency_seconds_bucket[5m])) by (le))", "legendFormat": "generation p50", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "title": "Tokens / sec by kind",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by (kind) (rate(runbookqa_tokens_total[5m]))", "legendFormat": "{{kind}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "title": "Requests by outcome",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum by (outcome) (runbookqa_ask_total)", "legendFormat": "{{outcome}}", "refId": "A"}
      ]
    }
  ]
}
