# Copy to .env and fill in. Never commit .env.
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
HF_TOKEN=

# Grafana login for the local dashboard. Change these in .env.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# API key for POST /ask (Bearer token). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: /ask returns 503 without it (fail-closed). Never commit .env.
RUNBOOKQA_API_KEY=change-me-to-a-long-random-secret
# Rate limit: requests per window, per API key.
RUNBOOKQA_RATE_LIMIT=10
RUNBOOKQA_RATE_WINDOW_S=60
