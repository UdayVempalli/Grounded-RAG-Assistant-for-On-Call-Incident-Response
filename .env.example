# Copy to .env and fill in. Never commit .env.
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
HF_TOKEN=

# Grafana login for the local dashboard. Change these in .env.
# Left empty on purpose: compose refuses to start until you choose them.
GRAFANA_USER=
GRAFANA_PASSWORD=

# API key for POST /ask (Bearer token). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: set a real key in .env (never commit .env). Left empty here
# on purpose: compose's :? check fails fast on an empty key instead of
# silently using a known placeholder.
RUNBOOKQA_API_KEY=
# Rate limit: requests per window, per API key.
RUNBOOKQA_RATE_LIMIT=10
RUNBOOKQA_RATE_WINDOW_S=60

# Admin key for POST /ingest (re-index). Must differ from the API key so an
# /ask client cannot trigger a re-index. Empty = /ingest disabled.
RUNBOOKQA_ADMIN_KEY=

# Ollama circuit breaker: open after N consecutive failed calls, retry after cooldown.
RUNBOOKQA_BREAKER_FAILURES=3
RUNBOOKQA_BREAKER_COOLDOWN_S=30

# Eval only: grade with a stronger model than the one generating (default: LLM_MODEL).
# JUDGE_MODEL=llama3.1:8b
